# AI engine (backend only — set in Vercel project settings, not VITE_ prefixed)
GROQ_API_KEY=

# Supabase (frontend-safe, VITE_ prefix required for Vite to expose them)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role (backend only — used by /api/plaid/* routes to write
# transactions without going through the browser client. Falls back to the
# anon key above if omitted, which works fine given schema.sql's permissive
# single-user RLS policies.)
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (backend only)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Transit/ephemeris API (backend only, optional — omit to use the built-in
# Sun-sign-by-date fallback in /api/transits.js)
TRANSIT_API_KEY=
